<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Selector de Torre Activa (Tabs) -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabTorres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabIndicatorColor="#1B5E20"
            app:tabMode="fixed"
            app:tabSelectedTextColor="#1B5E20" />

        <!-- Tarjeta de Cultivo Asignado -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvLabelCultivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cultivo de Torre 1"
                    android:textColor="#616161"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spnCultivo"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mediciones en tiempo real -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Mediciones de sensores"
            android:textColor="#212121"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:stretchColumns="1">

                <TableRow android:paddingBottom="6dp">
                    <TextView android:text="Temp. Aire" android:textColor="#424242" android:textStyle="bold" />
                    <TextView android:id="@+id/tvTempAire" android:gravity="end" android:text="-- °C" android:textColor="#212121" />
                    <TextView android:id="@+id/tvRangoAire" android:layout_marginStart="8dp" android:text="(--)" android:textColor="#757575" android:textSize="11sp" />
                </TableRow>

                <TableRow android:paddingBottom="6dp">
                    <TextView android:text="Humedad" android:textColor="#424242" android:textStyle="bold" />
                    <TextView android:id="@+id/tvHumedad" android:gravity="end" android:text="-- %" android:textColor="#212121" />
                    <TextView android:layout_marginStart="8dp" android:text="(Óptimo)" android:textColor="#757575" android:textSize="11sp" />
                </TableRow>

                <TableRow android:paddingBottom="6dp">
                    <TextView android:text="Temp. Agua" android:textColor="#424242" android:textStyle="bold" />
                    <TextView android:id="@+id/tvTempAgua" android:gravity="end" android:text="-- °C" android:textColor="#212121" />
                    <TextView android:id="@+id/tvRangoAgua" android:layout_marginStart="8dp" android:text="(--)" android:textColor="#757575" android:textSize="11sp" />
                </TableRow>

                <TableRow android:paddingBottom="6dp">
                    <TextView android:text="pH Solución" android:textColor="#424242" android:textStyle="bold" />
                    <TextView android:id="@+id/tvPh" android:gravity="end" android:text="--" android:textColor="#212121" />
                    <TextView android:id="@+id/tvRangoPh" android:layout_marginStart="8dp" android:text="(--)" android:textColor="#757575" android:textSize="11sp" />
                </TableRow>

                <TableRow android:paddingBottom="6dp">
                    <TextView android:text="Conductividad (EC)" android:textColor="#424242" android:textStyle="bold" />
                    <TextView android:id="@+id/tvEc" android:gravity="end" android:text="-- mS/cm" android:textColor="#212121" />
                    <TextView android:id="@+id/tvRangoEc" android:layout_marginStart="8dp" android:text="(--)" android:textColor="#757575" android:textSize="11sp" />
                </TableRow>

                <TableRow android:paddingBottom="6dp">
                    <TextView android:text="Luminosidad" android:textColor="#424242" android:textStyle="bold" />
                    <TextView android:id="@+id/tvLux" android:gravity="end" android:text="-- lux" android:textColor="#212121" />
                    <TextView android:layout_marginStart="8dp" android:text="(≥ 3000 lux)" android:textColor="#757575" android:textSize="11sp" />
                </TableRow>

                <TableRow>
                    <TextView android:text="Nivel Estanque" android:textColor="#424242" android:textStyle="bold" />
                    <TextView android:id="@+id/tvNivel" android:gravity="end" android:text="-- %" android:textColor="#212121" />
                    <TextView android:layout_marginStart="8dp" android:text="(≥ 30%)" android:textColor="#757575" android:textSize="11sp" />
                </TableRow>
            </TableLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Diagnóstico / Alertas Activas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Estado general y diagnóstico"
            android:textColor="#212121"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <TextView
                android:id="@+id/tvAlertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:padding="12dp"
                android:text="✓ Todos los parámetros dentro de rango."
                android:textColor="#1B5E20"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>