<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:orientation="vertical">

    <!-- Banner de Corte de Datos -->
    <TextView
        android:id="@+id/tvBannerCorte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/alerta_error"
        android:padding="8dp"
        android:text="@string/aviso_corte_datos"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvSinDatosReales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/superficie_tarjeta"
                android:padding="16dp"
                android:text="@string/inicio_sin_datos_reales"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutDatosHuerto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabTorres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tabIndicatorColor="@color/verde_primario"
                app:tabMode="fixed"
                app:tabSelectedTextColor="@color/verde_primario" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvLabelCultivo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inicio_cultivo_torre"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spnCultivo"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvAvisoSoloLectura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/inicio_demo_solo_lectura"
                        android:textColor="@color/texto_terciario"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/inicio_mediciones"
                android:textColor="@color/texto_principal"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:stretchColumns="1">

                    <TableRow android:paddingBottom="6dp">
                        <TextView android:text="@string/inicio_temp_aire" android:textColor="@color/texto_principal" android:textStyle="bold" />
                        <TextView android:id="@+id/tvTempAire" android:gravity="end" android:text="@string/placeholder_temperatura" android:textColor="@color/texto_principal" />
                        <TextView android:id="@+id/tvRangoAire" android:layout_marginStart="8dp" android:text="@string/placeholder_rango" android:textColor="@color/texto_terciario" android:textSize="11sp" />
                    </TableRow>

                    <TableRow android:paddingBottom="6dp">
                        <TextView android:text="@string/inicio_humedad" android:textColor="@color/texto_principal" android:textStyle="bold" />
                        <TextView android:id="@+id/tvHumedad" android:gravity="end" android:text="@string/placeholder_humedad" android:textColor="@color/texto_principal" />
                        <TextView android:layout_marginStart="8dp" android:text="@string/inicio_optimo" android:textColor="@color/texto_terciario" android:textSize="11sp" />
                    </TableRow>

                    <TableRow android:paddingBottom="6dp">
                        <TextView android:text="@string/inicio_temp_agua" android:textColor="@color/texto_principal" android:textStyle="bold" />
                        <TextView android:id="@+id/tvTempAgua" android:gravity="end" android:text="@string/placeholder_temperatura" android:textColor="@color/texto_principal" />
                        <TextView android:id="@+id/tvRangoAgua" android:layout_marginStart="8dp" android:text="@string/placeholder_rango" android:textColor="@color/texto_terciario" android:textSize="11sp" />
                    </TableRow>

                    <TableRow android:paddingBottom="6dp">
                        <TextView android:text="@string/inicio_ph" android:textColor="@color/texto_principal" android:textStyle="bold" />
                        <TextView android:id="@+id/tvPh" android:gravity="end" android:text="@string/inicio_ph_placeholder" android:textColor="@color/texto_principal" />
                        <TextView android:id="@+id/tvRangoPh" android:layout_marginStart="8dp" android:text="@string/placeholder_rango" android:textColor="@color/texto_terciario" android:textSize="11sp" />
                    </TableRow>

                    <TableRow android:paddingBottom="6dp">
                        <TextView android:text="@string/inicio_ec" android:textColor="@color/texto_principal" android:textStyle="bold" />
                        <TextView android:id="@+id/tvEc" android:gravity="end" android:text="@string/placeholder_ec" android:textColor="@color/texto_principal" />
                        <TextView android:id="@+id/tvRangoEc" android:layout_marginStart="8dp" android:text="@string/placeholder_rango" android:textColor="@color/texto_terciario" android:textSize="11sp" />
                    </TableRow>

                    <TableRow android:paddingBottom="6dp">
                        <TextView android:text="@string/inicio_luminosidad" android:textColor="@color/texto_principal" android:textStyle="bold" />
                        <TextView android:id="@+id/tvLux" android:gravity="end" android:text="@string/placeholder_lux" android:textColor="@color/texto_principal" />
                        <TextView android:layout_marginStart="8dp" android:text="@string/inicio_lux_minimo" android:textColor="@color/texto_terciario" android:textSize="11sp" />
                    </TableRow>

                    <TableRow>
                        <TextView android:text="@string/inicio_nivel_estanque" android:textColor="@color/texto_principal" android:textStyle="bold" />
                        <TextView android:id="@+id/tvNivel" android:gravity="end" android:text="@string/placeholder_nivel" android:textColor="@color/texto_principal" />
                        <TextView android:layout_marginStart="8dp" android:text="@string/inicio_nivel_minimo" android:textColor="@color/texto_terciario" android:textSize="11sp" />
                    </TableRow>
                </TableLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/inicio_diagnostico"
                android:textColor="@color/texto_principal"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp">

                <TextView
                    android:id="@+id/tvAlertas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:padding="12dp"
                    android:text="@string/alertas_todas_ok"
                    android:textColor="@color/alerta_ok"
                    android:textSize="13sp" />
            </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
