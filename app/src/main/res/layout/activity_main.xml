<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:orientation="vertical">

    <!-- BARRA SUPERIOR -->
    <LinearLayout
        android:id="@+id/toolbarAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_primario"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- TITULO Y AJUSTES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTituloToolbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="left"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />

            <ImageButton
                android:id="@+id/btnAjustesTop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ajustes_titulo"
                android:src="@android:drawable/ic_menu_preferences"
                app:tint="?attr/colorOnPrimary" />

        </LinearLayout>

        <!-- BOTONES DE TORRES Y SESION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnAgregarTorre"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/btn_agregar_torre"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="11sp"
                app:strokeColor="?attr/colorOnPrimary" />

            <Button
                android:id="@+id/btnEliminarTorre"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="@string/btn_eliminar_torre"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="11sp"
                app:strokeColor="?attr/colorOnPrimary" />

            <Button
                android:id="@+id/btnCerrarSesionTop"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/btn_salir"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="11sp"
                app:strokeColor="?attr/colorOnPrimary" />

        </LinearLayout>

    </LinearLayout>

    <!-- PESTAÑAS DE NAVEGACION -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabNavegacionAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie_tarjeta"
        android:layout_marginTop="0dp"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorColor="@color/verde_primario"
        app:tabIndicatorHeight="3dp"
        app:tabMode="scrollable"
        app:tabRippleColor="@color/verde_claro"
        app:tabSelectedTextColor="@color/verde_primario"
        app:tabTextColor="@color/texto_secundario">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_sensores" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_control" />

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tabItemUsuarios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_usuarios" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_historial" />

    </com.google.android.material.tabs.TabLayout>

    <!-- CONTENEDOR DE FRAGMENTS -->
    <FrameLayout
        android:id="@+id/contenedorFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
