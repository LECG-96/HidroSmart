<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado con selector de torres -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HidroSmart • Demo"
                android:textColor="#1B5E20"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="Torres:"
                android:textColor="#616161"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spnCantidadTorres"
                android:layout_width="wrap_content"
                android:layout_height="40dp" />
        </LinearLayout>

        <!-- Selector de Torre Activa (Tabs) -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabTorres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:tabIndicatorColor="#1B5E20"
            app:tabMode="fixed"
            app:tabSelectedTextColor="#1B5E20" />

        <!-- Cultivo asignado a esta torre -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvLabelCultivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cultivo de Torre 1"
                    android:textColor="#616161"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spnCultivo"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mediciones en tiempo real -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Mediciones de sensores"
            android:textColor="#212121"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:stretchColumns="1">

                <TableRow android:paddingBottom="4dp">
                    <TextView android:text="Temp. Aire" android:textColor="#424242" android:textStyle="bold" />
                    <TextView android:id="@+id/tvTempAire" android:gravity="end" android:text="-- °C" android:textColor="#212121" />
                    <TextView android:id="@+id/tvRangoAire" android:layout_marginStart="8dp" android:text="(--)" android:textColor="#757575" android:textSize="11sp" />
                </TableRow>

                <TableRow android:paddingBottom="4dp">
                    <TextView android:text="Humedad" android:textColor="#424242" android:textStyle="bold" />
                    <TextView android:id="@+id/tvHumedad" android:gravity="end" android:text="-- %" android:textColor="#212121" />
                    <TextView android:layout_marginStart="8dp" android:text="(Óptimo)" android:textColor="#757575" android:textSize="11sp" />
                </TableRow>

                <TableRow android:paddingBottom="4dp">
                    <TextView android:text="Temp. Agua" android:textColor="#424242" android:textStyle="bold" />
                    <TextView android:id="@+id/tvTempAgua" android:gravity="end" android:text="-- °C" android:textColor="#212121" />
                    <TextView android:id="@+id/tvRangoAgua" android:layout_marginStart="8dp" android:text="(--)" android:textColor="#757575" android:textSize="11sp" />
                </TableRow>

                <TableRow android:paddingBottom="4dp">
                    <TextView android:text="pH Solución" android:textColor="#424242" android:textStyle="bold" />
                    <TextView android:id="@+id/tvPh" android:gravity="end" android:text="--" android:textColor="#212121" />
                    <TextView android:id="@+id/tvRangoPh" android:layout_marginStart="8dp" android:text="(--)" android:textColor="#757575" android:textSize="11sp" />
                </TableRow>

                <TableRow android:paddingBottom="4dp">
                    <TextView android:text="Conductividad (EC)" android:textColor="#424242" android:textStyle="bold" />
                    <TextView android:id="@+id/tvEc" android:gravity="end" android:text="-- mS/cm" android:textColor="#212121" />
                    <TextView android:id="@+id/tvRangoEc" android:layout_marginStart="8dp" android:text="(--)" android:textColor="#757575" android:textSize="11sp" />
                </TableRow>

                <TableRow android:paddingBottom="4dp">
                    <TextView android:text="Luminosidad" android:textColor="#424242" android:textStyle="bold" />
                    <TextView android:id="@+id/tvLux" android:gravity="end" android:text="-- lux" android:textColor="#212121" />
                    <TextView android:layout_marginStart="8dp" android:text="(≥ 3000 lux)" android:textColor="#757575" android:textSize="11sp" />
                </TableRow>

                <TableRow>
                    <TextView android:text="Nivel Estanque" android:textColor="#424242" android:textStyle="bold" />
                    <TextView android:id="@+id/tvNivel" android:gravity="end" android:text="-- %" android:textColor="#212121" />
                    <TextView android:layout_marginStart="8dp" android:text="(≥ 30%)" android:textColor="#757575" android:textSize="11sp" />
                </TableRow>
            </TableLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Salidas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Estado de actuadores"
            android:textColor="#212121"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="10dp">

                <TextView android:id="@+id/actVentilador" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp" android:text="○ Ventilador: OFF" />
                <TextView android:id="@+id/actLed" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp" android:text="○ LED Cultivo: OFF" />
                <TextView android:id="@+id/actBomba" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp" android:text="○ Riego: OFF" />
                <TextView android:id="@+id/actNutrientes" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp" android:text="○ Nutrientes: OFF" />
                <TextView android:id="@+id/actPhPump" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp" android:text="○ pH Down: OFF" />
                <TextView android:id="@+id/actCerradura" android:layout_width="0dp" android:layout_columnWeight="1" android:padding="4dp" android:text="○ Cerradura: CERRADA" />
            </GridLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Alertas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Alertas y diagnóstico"
            android:textColor="#212121"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <TextView
                android:id="@+id/tvAlertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:padding="10dp"
                android:text="✓ Todos los parámetros dentro de rango."
                android:textColor="#1B5E20"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Botonera de Escenarios -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Aplicar escenario a esta torre"
            android:textColor="#212121"
            android:textSize="15sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:columnCount="2">

            <Button android:id="@+id/btnEscCalor" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="Calor" />
            <Button android:id="@+id/btnEscFrio" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="Frío" />
            <Button android:id="@+id/btnEscAguaCal" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="Agua caliente" />
            <Button android:id="@+id/btnEscAguaFria" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="Agua fría" />
            <Button android:id="@+id/btnEscPhAlto" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="pH alto" />
            <Button android:id="@+id/btnEscPhBajo" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="pH bajo" />
            <Button android:id="@+id/btnEscEcBaja" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="EC baja" />
            <Button android:id="@+id/btnEscEcAlta" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="EC alta" />
            <Button android:id="@+id/btnEscOscuridad" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="Poca luz" />
            <Button android:id="@+id/btnEscNivelBajo" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="Nivel bajo" />
            <Button android:id="@+id/btnEscNivelCritico" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="Nivel crítico" />
            <Button android:id="@+id/btnEscNormal" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:text="Normal" />
        </GridLayout>

        <Button
            android:id="@+id/btnRellenarEstanque"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Rellenar estanque (100 %)" />

    </LinearLayout>
</ScrollView>