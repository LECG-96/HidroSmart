<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:orientation="vertical">

    <!-- Barra superior común -->
    <LinearLayout
        android:id="@+id/toolbarAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvTituloToolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HidroSmart"
            android:textColor="#1B5E20"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Acciones dinámicas de administración de torres (ocultas para USER) -->
        <Button
            android:id="@+id/btnAgregarTorre"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="+ Torre"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnEliminarTorre"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="- Torre"
            android:textColor="#B71C1C"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnCerrarSesionTop"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Salir"
            android:textColor="#757575"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Pestañas de navegación para ADMIN (Ocultas en USER) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabNavegacionAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E8F5E9"
        app:tabIndicatorColor="#1B5E20"
        app:tabMode="fixed"
        app:tabSelectedTextColor="#1B5E20">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensores" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Control &amp; Sim" />

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tabItemUsuarios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuarios" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Contenedor central donde se cargan los Fragments -->
    <FrameLayout
        android:id="@+id/contenedorFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>