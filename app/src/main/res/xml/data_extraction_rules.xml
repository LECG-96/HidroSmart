<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Mantener la base de cuentas únicamente en el dispositivo. -->
        <exclude domain="database" path="hidrosmart_usuarios.db" />
        <exclude domain="database" path="hidrosmart_usuarios.db-wal" />
        <exclude domain="database" path="hidrosmart_usuarios.db-shm" />
        <exclude domain="database" path="hidrosmart_usuarios.db-journal" />
    </cloud-backup>
    <device-transfer>
        <!-- Evitar que una migración copie hashes de cuentas locales. -->
        <exclude domain="database" path="hidrosmart_usuarios.db" />
        <exclude domain="database" path="hidrosmart_usuarios.db-wal" />
        <exclude domain="database" path="hidrosmart_usuarios.db-shm" />
        <exclude domain="database" path="hidrosmart_usuarios.db-journal" />
    </device-transfer>
</data-extraction-rules>
