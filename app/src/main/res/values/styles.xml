<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Hidro.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/superficie_tarjeta</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/divisor</item>
    </style>

    <style name="Widget.HidroSmart.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.HidroSmart.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
